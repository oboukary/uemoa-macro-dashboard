# Copiez ce fichier en `.env` et renseignez vos valeurs.
# Le fichier .env n'est PAS versionné (voir .gitignore).

# Clé API FRED (St. Louis Fed) — optionnelle, pour le contexte mondial (V2).
# Obtenir une clé gratuite : https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Durée de cache des appels API, en secondes (6 h par défaut).
CACHE_TTL=21600
